        <button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>
      </form>

      <form id="newPasswordForm" class="hidden">
        <div class="field">
          <label>New Password</label>
          <input id="newPassword" type="password" minlength="6" required>
