<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
/* =====================================================
   SUPABASE CONFIG
   ONLY THE PUBLIC/PUBLISHABLE KEY BELONGS HERE.
===================================================== */

const SUPABASE_URL = "https://igswdaioxynnnrleoidb.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_Snx1rI2iITsjgVZCrVcf6Q_E_K1rWcU";

const supabase = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_PUBLISHABLE_KEY,
  {
    auth: {
      persistSession: true,
      autoRefreshToken: true,
      detectSessionInUrl: true,
      flowType: "pkce"
    }
  }
);


/* =====================================================
   STATE
===================================================== */

let currentSession = null;
let currentProfile = null;
let locations = [];
let jobs = [];
let profiles = [];
let featuredJob = null;
let editingJobId = null;
let selectedApplicationForRating = null;


/* =====================================================
   ELEMENT HELPERS
===================================================== */

const $ = id => document.getElementById(id);

function show(id){
  $(id).classList.remove("hidden");
}

function hide(id){
  $(id).classList.add("hidden");
}

function setMessage(id, type, text){
  $(id).innerHTML = text
    ? `<div class="${type}">${escapeHTML(text)}</div>`
    : "";
}

function escapeHTML(value){
  return String(value ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function initials(name){
  return String(name || "HANJOBS User")
    .split(" ")
    .filter(Boolean)
    .slice(0,2)
    .map(x => x[0].toUpperCase())
    .join("");
}

function locationLabel(location){
  if(!location) return "Location not specified";
  return [location.town, location.area].filter(Boolean).join(" — ");
}

function moneyText(job){
  return job.pay || "Pay not specified";
}

function scrollTo(id){
  const el = $(id);
  if(el) el.scrollIntoView({behavior:"smooth",block:"start"});
}

function openModal(id){ show(id); }
function closeModal(id){ hide(id); }


/* =====================================================
   AUTH UI
===================================================== */

function setAuthMode(mode){
  const login = mode === "login";

  $("authTitle").textContent = login ? "Sign In" : "Create Account";
  $("loginForm").classList.toggle("hidden", !login);
  $("signupForm").classList.toggle("hidden", login);
  $("loginTab").classList.toggle("active", login);
  $("signupTab").classList.toggle("active", !login);
  $("authMessage").innerHTML = "";
}

$("authButton").addEventListener("click", async () => {
  if(currentSession){
    await supabase.auth.signOut();
  }else{
    setAuthMode("login");
    openModal("authModal");
  }
});

$("loginTab").addEventListener("click", () => setAuthMode("login"));
$("signupTab").addEventListener("click", () => setAuthMode("signup"));


/* =====================================================
   SIGN UP
===================================================== */

$("signupForm").addEventListener("submit", async event => {
  event.preventDefault();

  const button = $("signupSubmit");
  button.disabled = true;
  button.textContent = "Creating account...";
  $("authMessage").innerHTML = "";

  try{
    const { data, error } = await supabase.auth.signUp({
      email: $("signupEmail").value.trim(),
      password: $("signupPassword").value,
      options: {
        data: {
          full_name: $("signupName").value.trim(),
          account_type: $("signupType").value
        }
      }
    });

    if(error) throw error;

    if(data.session){
      setMessage("authMessage","success","Account created. You're signed in.");
    }else{
      setMessage(
        "authMessage",
        "success",
        "Account created. Check your email to confirm the account, then sign in."
      );
    }

  }catch(error){
    setMessage("authMessage","error",error.message || "Could not create account.");
  }finally{
    button.disabled = false;
    button.textContent = "Create Account";
  }
});


/* =====================================================
   LOGIN
===================================================== */

$("loginForm").addEventListener("submit", async event => {
  event.preventDefault();

  const button = $("loginSubmit");
  button.disabled = true;
  button.textContent = "Signing in...";
  $("authMessage").innerHTML = "";

  try{
    const { error } = await supabase.auth.signInWithPassword({
      email: $("loginEmail").value.trim(),
      password: $("loginPassword").value
    });

    if(error) throw error;

    closeModal("authModal");

  }catch(error){
    setMessage("authMessage","error",error.message || "Could not sign in.");
  }finally{
    button.disabled = false;
    button.textContent = "Sign In";
  }
});


/* =====================================================
   PASSWORD RESET
===================================================== */

$("forgotButton").addEventListener("click", () => {
  closeModal("authModal");
  $("requestResetForm").classList.remove("hidden");
  $("newPasswordForm").classList.add("hidden");
  $("resetMessage").innerHTML = "";
  openModal("resetModal");
});

$("requestResetForm").addEventListener("submit", async event => {
  event.preventDefault();

  const email = $("resetEmail").value.trim();

  try{
    const redirectTo = window.location.origin + window.location.pathname;

    const { error } = await supabase.auth.resetPasswordForEmail(email,{
      redirectTo
    });

    if(error) throw error;

    setMessage(
      "resetMessage",
      "success",
      "If an account exists for that email, a reset link has been sent."
    );

  }catch(error){
    setMessage("resetMessage","error",error.message || "Could not request password reset.");
  }
});

$("newPasswordForm").addEventListener("submit", async event => {
  event.preventDefault();

  const password = $("newPassword").value;
  const confirm = $("newPasswordConfirm").value;

  if(password !== confirm){
    setMessage("resetMessage","error","The passwords do not match.");
    return;
  }

  try{
    const { error } = await supabase.auth.updateUser({password});
    if(error) throw error;

    setMessage("resetMessage","success","Password updated successfully.");

    setTimeout(() => closeModal("resetModal"),900);

  }catch(error){
    setMessage("resetMessage","error",error.message || "Could not update password.");
  }
});


/* =====================================================
   AUTH STATE
===================================================== */

supabase.auth.onAuthStateChange(async (event, session) => {
  currentSession = session;
  await refreshCurrentUser();

  if(event === "PASSWORD_RECOVERY"){
    $("requestResetForm").classList.add("hidden");
    $("newPasswordForm").classList.remove("hidden");
    $("resetMessage").innerHTML = "";
    openModal("resetModal");
  }
});

async function refreshCurrentUser(){
  if(!currentSession){
    currentProfile = null;
    updateAuthUI();
    renderDashboardSignedOut();
    return;
  }

  const { data, error } = await supabase
    .from("profiles")
    .select(`
      id,
      user_id,
      is_demo,
      account_type,
      display_name,
      username,
      avatar_url,
      instagram_username,
      bio,
      jobs_completed,
      average_rating,
      created_at,
      location_id,
      locations(town,county,area)
    `)
    .eq("user_id",currentSession.user.id)
    .maybeSingle();

  if(error){
    console.error(error);
    currentProfile = null;
  }else{
    currentProfile = data;
  }

  updateAuthUI();
  renderDashboardSignedOut();
}

function updateAuthUI(){
  if(currentSession && currentProfile){
    $("authButton").textContent = "Log Out";
    $("userPill").classList.remove("hidden");
    $("userPill").textContent = currentProfile.display_name;
  }else if(currentSession){
    $("authButton").textContent = "Log Out";
    $("userPill").classList.remove("hidden");
    $("userPill").textContent = currentSession.user.email;
  }else{
    $("authButton").textContent = "Sign In";
    $("userPill").classList.add("hidden");
  }
}


/* =====================================================
   DATA LOADING
===================================================== */

async function loadAll(){
  await loadLocations();
  await Promise.all([
    loadJobs(),
    loadProfiles(),
    loadFeaturedJob(),
    loadCompletedHighlights()
  ]);
  await refreshCurrentUser();
}

async function loadLocations(){
  const { data, error } = await supabase
    .from("locations")
    .select("id,county,town,area")
    .order("town")
    .order("area");

  if(error){
    console.error(error);
    return;
  }

  locations = data || [];
  renderLocationControls();
}

async function loadJobs(){
  const { data, error } = await supabase
    .from("jobs")
    .select(`
      id,
      owner_profile_id,
      is_demo,
      title,
      description,
      job_type,
      pay,
      start_at,
      requirements,
      status,
      created_at,
      updated_at,
      locations(id,county,town,area),
      profiles!jobs_owner_profile_id_fkey(
        id,
        display_name,
        username,
        avatar_url,
        is_demo,
        jobs_completed,
        average_rating
      )
    `)
    .eq("status","active")
    .order("created_at",{ascending:false});

  if(error){
    console.error(error);
    $("jobsGrid").innerHTML = `<div class="no-results">Could not load jobs. ${escapeHTML(error.message)}</div>`;
    return;
  }

  jobs = data || [];
  renderJobs();
}

async function loadProfiles(){
  const { data, error } = await supabase
    .from("profiles")
    .select(`
      id,
      user_id,
      is_demo,
      display_name,
      username,
      avatar_url,
      instagram_username,
      bio,
      jobs_completed,
      average_rating,
      created_at,
      locations(id,county,town,area)
    `)
    .order("created_at",{ascending:false})
    .limit(12);

  if(error){
    console.error(error);
    return;
  }

  profiles = data || [];
  renderProfiles();
}

async function loadFeaturedJob(){
  const today = new Date().toISOString().slice(0,10);

  const { data, error } = await supabase
    .from("featured_jobs")
    .select(`
      featured_date,
      jobs!featured_jobs_job_id_fkey(
        id,
        is_demo,
        title,
        description,
        pay,
        job_type,
        start_at,
        requirements,
        locations(id,county,town,area),
        profiles!jobs_owner_profile_id_fkey(display_name)
      )
    `)
    .eq("featured_date",today)
    .maybeSingle();

  if(error){
    console.error(error);
  }

  if(data && data.jobs){
    featuredJob = data.jobs;
  }else{
    featuredJob = jobs.find(job => job.is_demo) || jobs[0] || null;
  }

  renderFeaturedJob();
}

async function loadCompletedHighlights(){
  const { data, error } = await supabase
    .from("completed_job_highlights")
    .select("*")
    .order("completed_at",{ascending:false})
    .limit(12);

  if(error){
    console.error(error);
    return;
  }

  renderCompletedHighlights(data || []);
}


/* =====================================================
   LOCATION UI
===================================================== */

function renderLocationControls(){
  const currentFilter = $("locationFilter").value;
  const currentJobLocation = $("jobLocation").value;
  const currentProfileLocation = $("profileLocation").value;

  $("locationFilter").innerHTML =
    `<option value="all">All locations</option>` +
    locations.map(location => `
      <option value="${escapeHTML(location.id)}">
        ${escapeHTML(locationLabel(location))}
      </option>
    `).join("");

  $("jobLocation").innerHTML =
    `<option value="">Select location</option>` +
    locations.map(location => `
      <option value="${escapeHTML(location.id)}">
        ${escapeHTML(locationLabel(location))}
      </option>
    `).join("");

  $("profileLocation").innerHTML =
    `<option value="">Select location</option>` +
    locations.map(location => `
      <option value="${escapeHTML(location.id)}">
        ${escapeHTML(locationLabel(location))}
      </option>
    `).join("");

  if(locations.some(x => x.id === currentFilter)) $("locationFilter").value=currentFilter;
  if(locations.some(x => x.id === currentJobLocation)) $("jobLocation").value=currentJobLocation;
  if(locations.some(x => x.id === currentProfileLocation)) $("profileLocation").value=currentProfileLocation;

  $("locationTags").innerHTML = locations
    .map(location => `<span class="location-tag">${escapeHTML(locationLabel(location))}</span>`)
    .join("");
}


/* =====================================================
   JOB SEARCH + RENDER
===================================================== */

function filteredJobs(){
  const query = $("jobSearch").value.trim().toLowerCase();
  const location = $("locationFilter").value;
  const type = $("typeFilter").value;
  const pay = $("payFilter").value;
  const sort = $("sortFilter").value;

  let list = jobs.filter(job => {
    const searchable = [
      job.title,
      job.description,
      job.profiles?.display_name,
      job.locations?.town,
      job.locations?.area,
      ...(job.requirements || [])
    ].join(" ").toLowerCase();

    if(query && !searchable.includes(query)) return false;
    if(location !== "all" && job.locations?.id !== location) return false;
    if(type !== "all" && job.job_type !== type) return false;

    if(pay === "with_pay" && !job.pay) return false;
    if(pay === "without_pay" && job.pay) return false;

    return true;
  });

  if(sort === "az"){
    list.sort((a,b)=>a.title.localeCompare(b.title));
  }

  if(sort === "za"){
    list.sort((a,b)=>b.title.localeCompare(a.title));
  }

  if(sort === "newest"){
    list.sort((a,b)=>new Date(b.created_at)-new Date(a.created_at));
  }

  return list;
}

function renderJobs(){
  const list = filteredJobs();

  $("resultsCount").textContent =
    `${list.length} job${list.length===1?"":"s"} available`;

  if(!list.length){
    $("jobsGrid").innerHTML = `
      <div class="no-results">
        <strong>No jobs found.</strong>
        <div style="margin-top:6px;">Try another search or location.</div>
      </div>
    `;
    return;
  }

  $("jobsGrid").innerHTML = list.map(job => `
    <article class="job-card">

      <div class="job-head">
        <div>
          <div class="company">
            ${escapeHTML(job.profiles?.display_name || "HANJOBS Employer")}
          </div>
          <h3 class="job-title">${escapeHTML(job.title)}</h3>
        </div>

        <div class="badges">
          ${job.is_demo ? `<span class="badge badge-demo">DEMO JOB</span>` : ""}
          <span class="badge">${escapeHTML(job.job_type)}</span>
        </div>
      </div>

      <p class="job-description">
        ${escapeHTML(job.description)}
      </p>

      <div class="job-meta">
        <span><i class="dot"></i>${escapeHTML(locationLabel(job.locations))}</span>
        <span><i class="dot"></i>${escapeHTML(job.job_type)}</span>
        <span><i class="dot"></i>${escapeHTML(job.pay || "Pay not specified")}</span>
      </div>

      <div class="job-bottom">
        <div class="salary">
          ${escapeHTML(moneyText(job))}
        </div>

        <div class="job-buttons">
          <button class="btn btn-secondary" onclick="viewJob('${job.id}')">
            View
          </button>

          <button
            class="btn btn-primary"
            ${job.is_demo ? "disabled" : ""}
            onclick="applyJob('${job.id}')"
          >
            ${job.is_demo ? "Demo Listing" : "Apply"}
          </button>
        </div>
      </div>

    </article>
  `).join("");
}

["jobSearch","locationFilter","typeFilter","payFilter","sortFilter"]
  .forEach(id => $(id).addEventListener("input",renderJobs));

["locationFilter","typeFilter","payFilter","sortFilter"]
  .forEach(id => $(id).addEventListener("change",renderJobs));


/* =====================================================
   FEATURED JOB
===================================================== */

function renderFeaturedJob(){
  if(!featuredJob){
    $("featuredJob").innerHTML = `<div class="no-results">No featured job available yet.</div>`;
    return;
  }

  $("featuredJob").innerHTML = `
    <div>
      <div class="feature-label">BRO OF THE DAY ${featuredJob.is_demo ? "· DEMO LISTING" : ""}</div>
      <div class="feature-title">${escapeHTML(featuredJob.title)}</div>
      <div class="feature-copy">${escapeHTML(featuredJob.description)}</div>

      <div class="feature-meta">
        <div class="meta-box">
          <span>LOCATION</span>
          <strong>${escapeHTML(locationLabel(featuredJob.locations))}</strong>
        </div>

        <div class="meta-box">
          <span>JOB TYPE</span>
          <strong>${escapeHTML(featuredJob.job_type)}</strong>
        </div>
      </div>
    </div>

    <div class="feature-side">
      <div class="feature-pay">
        ${escapeHTML(moneyText(featuredJob))}
      </div>

      <button
        class="btn btn-primary btn-block"
        ${featuredJob.is_demo ? "disabled" : ""}
        onclick="applyJob('${featuredJob.id}')"
      >
        ${featuredJob.is_demo ? "Demo Listing" : "Apply for This Bro Job"}
      </button>
    </div>
  `;
}


/* =====================================================
   COMPLETED HIGHLIGHTS
===================================================== */

function renderCompletedHighlights(data){
  const highlight = data[0];

  if(!highlight){
    $("completedHighlight").innerHTML = `
      <div class="completed-label">COMMUNITY ACTIVITY</div>
      <div class="completed-title">No completed jobs yet.</div>
      <div class="completed-quote">Once real HANJOBS jobs are completed, they can appear here.</div>
    `;
    $("completedTotal").textContent = "0";
    $("averageCommunityRating").textContent = "—";
    return;
  }

  $("completedHighlight").innerHTML = `
    <div class="completed-label">
      ${highlight.is_demo ? "DEMO COMMUNITY ACTIVITY" : "REAL COMMUNITY ACTIVITY"}
    </div>

    <div class="completed-title">
      ${escapeHTML(highlight.job_title)}
    </div>

    <div class="completed-meta">
      <span>Completed by: ${escapeHTML(highlight.completed_by_name)}</span>
      <span>${escapeHTML(highlight.location_label || "Kenya")}</span>
      <span class="stars">
        ${highlight.rating ? "★★★★★" : "Not rated yet"}
      </span>
    </div>

    <div class="completed-quote">
      ${escapeHTML(highlight.review || "Completed successfully. No review yet.")}
    </div>

    <button
      class="btn btn-secondary"
      style="margin-top:18px"
      onclick="openProfileByName('${escapeHTML(highlight.completed_by_name)}')"
    >
      View Bro Profiles
    </button>
  `;

  const realRated = data.filter(x => !x.is_demo && x.rating != null);
  const allCompletedReal = data.filter(x => !x.is_demo).length;

  $("completedTotal").textContent = allCompletedReal || (data.filter(x => x.is_demo).length ? "Demo" : "0");

  if(realRated.length){
    const avg = realRated.reduce((sum,item)=>sum+Number(item.rating),0)/realRated.length;
    $("averageCommunityRating").textContent = avg.toFixed(1) + "/5";
  }else{
    $("averageCommunityRating").textContent = highlight.rating ? Number(highlight.rating).toFixed(1)+"/5" : "—";
  }
}


/* =====================================================
   PROFILES
===================================================== */

function profileCard(profile){
  return `
    <article class="profile-card">

      ${profile.is_demo ? `<div class="profile-demo">DEMO PROFILE</div>` : ""}

      <div class="profile-top">

        <div class="avatar">
          ${profile.avatar_url
            ? `<img src="${escapeHTML(profile.avatar_url)}" alt="Profile photo">`
            : escapeHTML(initials(profile.display_name))}
        </div>

        <div>
          <div class="profile-name">${escapeHTML(profile.display_name)}</div>
          <div class="profile-location">
            ${escapeHTML(locationLabel(profile.locations))}
          </div>
        </div>

      </div>

      <div class="profile-rating">
        ${Number(profile.average_rating) > 0
          ? `<span class="stars">★★★★★</span>
             <span style="color:#68788c;font-size:12px;letter-spacing:0;margin-left:5px;">
               ${Number(profile.average_rating).toFixed(1)}
             </span>`
          : `<span style="color:#68788c;font-weight:800;">NEW BRO</span>`}
      </div>

      <div class="profile-stats">

        <div class="profile-stat">
          <strong>${escapeHTML(profile.jobs_completed)}</strong>
          <span>Jobs Completed</span>
        </div>

        <div class="profile-stat">
          <strong>${profile.average_rating > 0 ? Number(profile.average_rating).toFixed(1) : "—"}</strong>
          <span>Rating</span>
        </div>

      </div>

      ${profile.instagram_username
        ? `<a
             class="instagram-link"
             href="https://instagram.com/${escapeHTML(profile.instagram_username.replace(/^@/,""))}"
             target="_blank"
             rel="noopener noreferrer"
           >
             View Instagram
           </a>`
        : ""}

      <button
        class="btn btn-secondary btn-block"
        style="margin-top:15px"
        onclick="viewProfile('${profile.id}')"
      >
        View Profile
      </button>

    </article>
  `;
}

function renderProfiles(){
  if(!profiles.length){
    $("profilesGrid").innerHTML = `<div class="no-results">No profiles yet.</div>`;
    return;
  }

  $("profilesGrid").innerHTML = profiles
    .map(profileCard)
    .join("");
}

async function viewProfile(profileId){
  const { data, error } = await supabase
    .from("profiles")
    .select(`
      id,
      user_id,
      is_demo,
      display_name,
      username,
      avatar_url,
      instagram_username,
      bio,
      jobs_completed,
      average_rating,
      created_at,
      locations(id,county,town,area)
    `)
    .eq("id",profileId)
    .maybeSingle();

  if(error || !data){
    alert(error?.message || "Profile not found.");
    return;
  }

  const { data: ratings } = await supabase
    .from("ratings")
    .select(`
      rating,
      review,
      created_at,
      profiles!ratings_reviewer_profile_id_fkey(display_name)
    `)
    .eq("reviewed_profile_id",profileId)
    .order("created_at",{ascending:false})
    .limit(10);

  $("publicProfileBody").innerHTML = `
    ${data.is_demo ? `<div class="demo-banner">DEMO PROFILE — example data, not a real HANJOBS account.</div>` : ""}

    <div class="profile-view-head">

      <div class="avatar" style="width:72px;height:72px;font-size:22px;">
        ${data.avatar_url
          ? `<img src="${escapeHTML(data.avatar_url)}" alt="Profile photo">`
          : escapeHTML(initials(data.display_name))}
      </div>

      <div>
        <div style="font-size:25px;font-weight:900;color:#102a43;">
          ${escapeHTML(data.display_name)}
        </div>
        <div style="color:#68788c;font-size:14px;">
          ${escapeHTML(locationLabel(data.locations))}
        </div>
      </div>

    </div>

    ${data.bio
      ? `<div class="profile-bio">${escapeHTML(data.bio)}</div>`
      : ""}

    <div class="profile-stats">
      <div class="profile-stat">
        <strong>${escapeHTML(data.jobs_completed)}</strong>
        <span>Bro Jobs Completed</span>
      </div>
      <div class="profile-stat">
        <strong>${data.average_rating > 0 ? Number(data.average_rating).toFixed(1) : "—"}</strong>
        <span>Average Rating</span>
      </div>
    </div>

    ${data.username
      ? `<div style="margin-top:15px;color:#68788c;font-size:13px;">@${escapeHTML(data.username.replace(/^@/,""))}</div>`
      : ""}

    ${data.instagram_username
      ? `<a
          class="btn btn-secondary"
          style="margin-top:16px;display:inline-block"
          href="https://instagram.com/${escapeHTML(data.instagram_username.replace(/^@/,""))}"
          target="_blank"
          rel="noopener noreferrer"
        >
          View Instagram
        </a>`
      : ""}

    <div class="rating-list">
      <div style="padding:15px 0;font-weight:900;color:#102a43;">Employer / Bro Feedback</div>
      ${(ratings || []).length
        ? ratings.map(r => `
          <div class="rating-item">
            <div class="rating-author">
              ${escapeHTML(r.profiles?.display_name || "HANJOBS User")}
              <span class="stars" style="margin-left:6px;">${"★".repeat(Number(r.rating))}</span>
            </div>
            ${r.review ? `<div class="rating-text">${escapeHTML(r.review)}</div>` : ""}
          </div>
        `).join("")
        : `<div style="padding:15px 0;color:#68788c;font-size:13px;">No public ratings yet.</div>`}
    </div>
  `;

  openModal("publicProfileModal");
}

function openProfileByName(name){
  const profile = profiles.find(p => p.display_name === name || p.display_name === name.replace(". M.",""));
  if(profile) viewProfile(profile.id);
  else alert("This demo completed-job profile is illustrative only.");
}


/* =====================================================
   PROFILE EDIT
===================================================== */

$("profileButton").addEventListener("click", async () => {
  if(!currentSession){
    setAuthMode("signup");
    openModal("authModal");
    return;
  }

  if(!currentProfile){
    await refreshCurrentUser();
  }

  if(!currentProfile){
    alert("Your profile has not loaded yet. Please sign out and sign in again.");
    return;
  }

  $("profileName").value = currentProfile.display_name || "";
  $("profileUsername").value = currentProfile.username ? "@" + currentProfile.username.replace(/^@/,"") : "";
  $("profileLocation").value = currentProfile.location_id || "";
  $("profileInstagram").value = currentProfile.instagram_username || "";
  $("profileBio").value = currentProfile.bio || "";
  $("profileArea").value = currentProfile.locations?.area || "";
  $("profilePhoto").value = "";
  $("profileMessage").innerHTML = "";

  openModal("profileModal");
});

$("heroProfileButton").addEventListener("click", () => $("profileButton").click());

$("profileForm").addEventListener("submit", async event => {
  event.preventDefault();

  if(!currentSession || !currentProfile){
    setMessage("profileMessage","error","Please sign in first.");
    return;
  }

  const button = $("profileSubmit");
  button.disabled = true;
  button.textContent = "Saving profile...";
  $("profileMessage").innerHTML = "";

  try{
    let avatarUrl = currentProfile.avatar_url || null;
    const file = $("profilePhoto").files[0];

    if(file){
      if(file.size > 1024 * 1024){
        throw new Error("Profile photo must be 1MB or smaller.");
      }

      const extension = file.type === "image/png" ? "png" : file.type === "image/webp" ? "webp" : "jpg";
      const path = `${currentSession.user.id}/${Date.now()}.${extension}`;

      const { error: uploadError } = await supabase
        .storage
        .from("avatars")
        .upload(path,file,{contentType:file.type});

      if(uploadError) throw uploadError;

      const { data: publicData } = supabase
        .storage
        .from("avatars")
        .getPublicUrl(path);

      avatarUrl = publicData.publicUrl;
    }

    let username = $("profileUsername").value.trim().replace(/^@/,"");
    username = username || null;

    let instagram = $("profileInstagram").value.trim();
    instagram = instagram || null;

    const { error } = await supabase
      .from("profiles")
      .update({
        display_name: $("profileName").value.trim(),
        username,
        location_id: $("profileLocation").value || null,
        instagram_username: instagram,
        bio: $("profileBio").value.trim() || null,
        avatar_url: avatarUrl
      })
      .eq("id",currentProfile.id);

    if(error) throw error;

    await refreshCurrentUser();
    await loadProfiles();

    setMessage("profileMessage","success","Profile saved to HANJOBS.");

  }catch(error){
    setMessage("profileMessage","error",error.message || "Could not save profile.");
  }finally{
    button.disabled = false;
    button.textContent = "Save Profile";
  }
});


/* =====================================================
   JOB POST / EDIT
===================================================== */

function requireAuth(action){
  if(currentSession && currentProfile) return true;

  setAuthMode("login");
  openModal("authModal");
  setMessage("authMessage","notice",`Sign in to ${action}.`);
  return false;
}

function openPostModal(){
  if(!requireAuth("post a Bro Job")) return;

  editingJobId = null;
  $("jobModalTitle").textContent = "Give a Bro a Job";
  $("jobSubmit").textContent = "Post Opening";
  $("jobForm").reset();
  $("jobMessage").innerHTML = "";
  openModal("jobModal");
}

$("postHeaderButton").addEventListener("click",openPostModal);
$("heroPostButton").addEventListener("click",openPostModal);

function openEditJob(job){
  if(!requireAuth("edit a job")) return;

  editingJobId = job.id;
  $("jobModalTitle").textContent = "Edit Job";
  $("jobSubmit").textContent = "Save Changes";
  $("jobMessage").innerHTML = "";

  $("jobTitle").value = job.title || "";
  $("jobDescription").value = job.description || "";
  $("jobLocation").value = job.locations?.id || "";
  $("jobType").value = job.job_type || "Casual";
  $("jobPay").value = job.pay || "";
  $("jobRequirements").value = (job.requirements || []).join("\n");

  if(job.start_at){
    const dt = new Date(job.start_at);
    const local = new Date(dt.getTime() - dt.getTimezoneOffset()*60000);
    $("jobDateTime").value = local.toISOString().slice(0,16);
  }else{
    $("jobDateTime").value = "";
  }

  openModal("jobModal");
}

$("jobForm").addEventListener("submit", async event => {
  event.preventDefault();

  if(!currentSession || !currentProfile){
    setMessage("jobMessage","error","Please sign in first.");
    return;
  }

  const button = $("jobSubmit");
  button.disabled = true;
  button.textContent = editingJobId ? "Saving..." : "Posting...";
  $("jobMessage").innerHTML = "";

  try{
    const requirements = $("jobRequirements").value
      .split("\n")
      .map(x => x.trim())
      .filter(Boolean);

    let startAt = null;
    if($("jobDateTime").value){
      startAt = new Date($("jobDateTime").value).toISOString();
    }

    const payload = {
      title: $("jobTitle").value.trim(),
      description: $("jobDescription").value.trim(),
      location_id: $("jobLocation").value,
      job_type: $("jobType").value,
      pay: $("jobPay").value.trim() || null,
      start_at: startAt,
      requirements,
      status:"active"
    };

    if(editingJobId){
      const { error } = await supabase
        .from("jobs")
        .update(payload)
        .eq("id",editingJobId)
        .eq("owner_profile_id",currentProfile.id);

      if(error) throw error;

      setMessage("jobMessage","success","Job updated.");

    }else{
      const { error } = await supabase
        .from("jobs")
        .insert({
          ...payload,
          owner_profile_id: currentProfile.id,
          is_demo:false
        });

      if(error) throw error;

      setMessage("jobMessage","success","Job posted successfully.");
    }

    await loadJobs();
    await loadProfiles();
    await new Promise(resolve => setTimeout(resolve,500));
    await renderDashboard();

    setTimeout(()=>closeModal("jobModal"),700);

  }catch(error){
    setMessage("jobMessage","error",error.message || "Could not save the job.");
  }finally{
    button.disabled = false;
    button.textContent = editingJobId ? "Save Changes" : "Post Opening";
  }
});


/* =====================================================
   JOB DETAIL + APPLY
===================================================== */

function viewJob(jobId){
  const job = jobs.find(x => x.id === jobId);
  if(!job) return;

  const ownJob = currentProfile && job.owner_profile_id === currentProfile.id;

  const requirements = (job.requirements || []).length
    ? `
      <div style="margin-top:18px;font-weight:900;color:#102a43;">Requirements</div>
      <ul class="requirements">
        ${(job.requirements || []).map(req => `<li>${escapeHTML(req)}</li>`).join("")}
      </ul>
    `
    : "";

  const demoMessage = job.is_demo
    ? `<div class="demo-banner">DEMO JOB — this listing is included as example content. It is not currently accepting real applications.</div>`
    : "";

  const applyButton = job.is_demo
    ? `<button class="btn btn-secondary" disabled>Demo Listing — No Applications</button>`
    : ownJob
      ? `<button class="btn btn-secondary" disabled>This is Your Job</button>`
      : `<button class="btn btn-primary" onclick="startApplication('${job.id}')">Apply for This Bro Job</button>`;

  $("jobDetailContent").innerHTML = `
    ${demoMessage}

    <div class="summary">
      <div class="summary-title">${escapeHTML(job.title)}</div>
      <div class="summary-meta">
        ${escapeHTML(job.profiles?.display_name || "HANJOBS Employer")}
        · ${escapeHTML(locationLabel(job.locations))}
        · ${escapeHTML(job.job_type)}
      </div>
      <div style="margin-top:10px;font-weight:900;color:#198754;">
        ${escapeHTML(moneyText(job))}
      </div>
    </div>

    <div class="detail-description">
      ${escapeHTML(job.description)}
    </div>

    ${requirements}

    <div style="margin-top:24px;display:flex;gap:9px;flex-wrap:wrap;">
      ${applyButton}
    </div>
  `;

  openModal("detailModal");
}

function applyJob(jobId){
  const job = jobs.find(x => x.id === jobId);
  if(!job) return;
  viewJob(jobId);
}

function startApplication(jobId){
  if(!requireAuth("apply for a Bro Job")) return;

  const job = jobs.find(x => x.id === jobId);
  if(!job) return;

  if(job.is_demo){
    alert("This is a demo listing and does not accept real applications yet.");
    return;
  }

  if(job.owner_profile_id === currentProfile.id){
    alert("You cannot apply to your own job.");
    return;
  }

  $("jobDetailContent").innerHTML = `
    <div class="summary">
      <div class="summary-title">Apply for ${escapeHTML(job.title)}</div>
      <div class="summary-meta">
        ${escapeHTML(job.profiles?.display_name || "HANJOBS Employer")}
        · ${escapeHTML(locationLabel(job.locations))}
      </div>
    </div>

    <form id="inlineApplicationForm">
      <div class="field">
        <label>Application Message</label>
        <textarea id="inlineApplicationMessage" required placeholder="Tell the employer why you're a good fit."></textarea>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Submit Application</button>
      <div id="inlineApplicationMessageBox"></div>
    </form>
  `;

  $("inlineApplicationForm").addEventListener("submit", async event => {
    event.preventDefault();

    const submit = event.target.querySelector("button[type='submit']");
    submit.disabled = true;
    submit.textContent = "Submitting application...";

    try{
      const { error } = await supabase
        .from("applications")
        .insert({
          job_id:job.id,
          applicant_profile_id:currentProfile.id,
          message:$("inlineApplicationMessage").value.trim()
        });

      if(error) throw error;

      setMessage(
        "inlineApplicationMessageBox",
        "success",
        "Application submitted. The employer can now see your profile and application."
      );

      await renderDashboard();

      setTimeout(()=>closeModal("detailModal"),900);

    }catch(error){
      setMessage(
        "inlineApplicationMessageBox",
        "error",
        error.message || "Could not submit the application."
      );
    }finally{
      submit.disabled = false;
      submit.textContent = "Submit Application";
    }
  });
}


/* =====================================================
   DASHBOARD
===================================================== */

function renderDashboardSignedOut(){
  if(currentSession && currentProfile){
    renderDashboard();
  }else{
    $("myJobs").innerHTML = `
      <div class="empty-dashboard">
        Sign in to see your jobs and applicants.
        <br><br>
        <button class="btn btn-primary" onclick="openAuthFromDashboard()">Sign In</button>
      </div>
    `;

    $("myApplications").innerHTML = `
      <div class="empty-dashboard">
        Sign in to track applications and completed jobs.
      </div>
    `;
  }
}

function openAuthFromDashboard(){
  setAuthMode("login");
  openModal("authModal");
}

async function renderDashboard(){
  if(!currentSession || !currentProfile){
    renderDashboardSignedOut();
    return;
  }

  await Promise.all([
    renderMyJobs(),
    renderMyApplications()
  ]);
}

async function renderMyJobs(){
  const { data, error } = await supabase
    .from("jobs")
    .select(`
      id,
      title,
      location_id,
      job_type,
      pay,
      status,
      created_at,
      is_demo,
      locations(id,county,town,area)
    `)
    .eq("owner_profile_id",currentProfile.id)
    .order("created_at",{ascending:false});

  if(error){
    $("myJobs").innerHTML = `<div class="error">${escapeHTML(error.message)}</div>`;
    return;
  }

  if(!data?.length){
    $("myJobs").innerHTML = `
      <div class="empty-dashboard">
        You haven't posted a job yet.
        <br><br>
        <button class="btn btn-primary" onclick="openPostModal()">Give a Bro a Job</button>
      </div>
    `;
    return;
  }

  let html = "";

  for(const job of data){
    const { data: applications, error: appError } = await supabase
      .from("applications")
      .select(`
        id,
        message,
        status,
        applied_at,
        applicant_profile_id,
        profiles!applications_applicant_profile_id_fkey(
          id,
          display_name,
          username,
          avatar_url,
          jobs_completed,
          average_rating,
          instagram_username,
          locations(id,county,town,area)
        )
      `)
      .eq("job_id",job.id)
      .order("applied_at",{ascending:false});

    if(appError) console.error(appError);

    html += `
      <div class="my-job">

        <div class="my-job-head">
          <div>
            <h4>${escapeHTML(job.title)}</h4>
            <small>
              ${escapeHTML(locationLabel(job.locations))}
              · ${escapeHTML(job.job_type)}
              · ${escapeHTML(job.pay || "Pay not specified")}
            </small>
          </div>

          <span class="status status-${escapeHTML(job.status)}">
            ${escapeHTML(job.status)}
          </span>
        </div>

        <div class="my-job-actions">
          <button class="btn btn-secondary" onclick="openEditJob(${JSON.stringify(job).replaceAll('"','&quot;')})">Edit</button>
          <button class="btn btn-danger" onclick="deleteJob('${job.id}')">Delete</button>
        </div>

        <div style="margin-top:14px;font-size:13px;font-weight:900;color:#102a43;">
          ${applications?.length || 0} applicant${applications?.length===1?"":"s"}
        </div>

        ${(applications || []).length
          ? applications.map(renderApplicantRow).join("")
          : `<div style="margin-top:9px;color:#68788c;font-size:12px;">No applications yet.</div>`}

      </div>
    `;
  }

  $("myJobs").innerHTML = html;
}

function renderApplicantRow(application){
  const profile = application.profiles;

  return `
    <div class="applicant">
      <div class="applicant-main">

        <div class="applicant-avatar">
          ${profile?.avatar_url
            ? `<img src="${escapeHTML(profile.avatar_url)}" alt="">`
            : escapeHTML(initials(profile?.display_name))}
        </div>

        <div>
          <div class="applicant-name">
            ${escapeHTML(profile?.display_name || "HANJOBS User")}
          </div>

          <div class="applicant-meta">
            ${escapeHTML(locationLabel(profile?.locations))}
            · ${escapeHTML(profile?.jobs_completed || 0)} jobs completed
          </div>

          <div class="applicant-rating">
            ${profile?.average_rating > 0
              ? "★".repeat(Math.round(profile.average_rating)) + " " + Number(profile.average_rating).toFixed(1)
              : "No rating yet"}
          </div>

        </div>
      </div>

      <div>
        <span class="status status-${escapeHTML(application.status)}">
          ${escapeHTML(application.status)}
        </span>

        <div class="applicant-buttons" style="margin-top:8px;">
          <button
            class="btn btn-secondary"
            onclick="viewProfile('${profile?.id}')"
          >
            Profile
          </button>

          ${(application.status === "applied" || application.status === "under_review")
            ? `
              <button class="btn btn-success" onclick="updateApplication('${application.id}','accepted')">Accept</button>
              <button class="btn btn-danger" onclick="updateApplication('${application.id}','declined')">Decline</button>
            `
            : ""}

          ${application.status === "accepted"
            ? `<button class="btn btn-success" onclick="updateApplication('${application.id}','completed')">Mark Completed</button>`
            : ""}

          ${application.status === "completed"
            ? `<button class="btn btn-secondary" onclick="rateApplicant('${application.id}','${profile?.id}','${escapeHTML(profile?.display_name || "Bro")}')">Rate Bro</button>`
            : ""}
        </div>
      </div>
    </div>
  `;
}

async function updateApplication(applicationId,status){
  try{
    const { error } = await supabase
      .from("applications")
      .update({status})
      .eq("id",applicationId);

    if(error) throw error;

    await loadJobs();
    await loadProfiles();
    await renderDashboard();
    await loadCompletedHighlights();

  }catch(error){
    alert(error.message || "Could not update application.");
  }
}

async function deleteJob(jobId){
  if(!confirm("Delete this job? This cannot be undone.")) return;

  try{
    const { error } = await supabase
      .from("jobs")
      .delete()
      .eq("id",jobId)
      .eq("owner_profile_id",currentProfile.id);

    if(error) throw error;

    await loadJobs();
    await renderDashboard();

  }catch(error){
    alert(error.message || "Could not delete job.");
  }
}

async function renderMyApplications(){
  const { data, error } = await supabase
    .from("applications")
    .select(`
      id,
      message,
      status,
      applied_at,
      job_id,
      jobs!applications_job_id_fkey(
        id,
        title,
        owner_profile_id,
        pay,
        job_type,
        status,
        locations(id,county,town,area),
        profiles!jobs_owner_profile_id_fkey(
          id,
          display_name,
          username
        )
      )
    `)
    .eq("applicant_profile_id",currentProfile.id)
    .order("applied_at",{ascending:false});

  if(error){
    $("myApplications").innerHTML = `<div class="error">${escapeHTML(error.message)}</div>`;
    return;
  }

  if(!data?.length){
    $("myApplications").innerHTML = `
      <div class="empty-dashboard">
        You haven't applied for any jobs yet.
        <br><br>
        <a class="btn btn-primary" href="#jobs">Find Jobs</a>
      </div>
    `;
    return;
  }

  $("myApplications").innerHTML = data.map(application => {
    const job = application.jobs;
    const employer = job?.profiles;

    return `
      <div class="my-job">

        <div class="my-job-head">
          <div>
            <h4>${escapeHTML(job?.title || "Job")}</h4>
            <small>
              ${escapeHTML(employer?.display_name || "Employer")}
              · ${escapeHTML(locationLabel(job?.locations))}
            </small>
          </div>

          <span class="status status-${escapeHTML(application.status)}">
            ${escapeHTML(application.status)}
          </span>
        </div>

        <div style="margin-top:8px;color:#68788c;font-size:12px;">
          Applied ${new Date(application.applied_at).toLocaleDateString()}
        </div>

        ${application.status === "completed"
          ? `
            <div class="my-job-actions">
              <button
                class="btn btn-secondary"
                onclick="rateEmployer('${application.id}','${employer?.id}','${escapeHTML(employer?.display_name || "Employer")}')"
              >
                Rate Employer
              </button>
            </div>
          `
          : ""}

      </div>
    `;
  }).join("");
}


/* =====================================================
   RATINGS
===================================================== */

function openRating(applicationId, rateeId, rateeName){
  selectedApplicationForRating = {
    applicationId,
    rateeId,
    rateeName
  };

  $("ratingSummary").innerHTML = `
    <strong>${escapeHTML(rateeName)}</strong>
    <div style="margin-top:5px;color:#68788c;font-size:13px;">
      Rate the completed HANJOBS job.
    </div>
  `;

  $("ratingForm").reset();
  $("ratingMessage").innerHTML = "";
  openModal("ratingModal");
}

function rateEmployer(applicationId, rateeId, rateeName){
  openRating(applicationId,rateeId,rateeName);
}

function rateApplicant(applicationId, rateeId, rateeName){
  openRating(applicationId,rateeId,rateeName);
}

$("ratingForm").addEventListener("submit",async event=>{
  event.preventDefault();

  if(!currentSession || !currentProfile || !selectedApplicationForRating){
    setMessage("ratingMessage","error","Please sign in first.");
    return;
  }

  try{
    const { data: app, error: appError } = await supabase
      .from("applications")
      .select("id,job_id,status")
      .eq("id",selectedApplicationForRating.applicationId)
      .single();

    if(appError) throw appError;
    if(app.status !== "completed") throw new Error("This job is not completed yet.");

    const { error } = await supabase
      .from("ratings")
      .insert({
        application_id:app.id,
        job_id:app.job_id,
        reviewer_profile_id:currentProfile.id,
        reviewed_profile_id:selectedApplicationForRating.rateeId,
        rating:Number($("ratingValue").value),
        review:$("ratingReview").value.trim() || null
      });

    if(error) throw error;

    setMessage("ratingMessage","success","Rating submitted.");

    await loadProfiles();
    await renderDashboard();

    setTimeout(()=>closeModal("ratingModal"),800);

  }catch(error){
    setMessage("ratingMessage","error",error.message || "Could not submit rating.");
  }
});


/* =====================================================
   NAV BUTTONS
===================================================== */

$("heroSearchButton").addEventListener("click",()=>{
  $("jobSearch").value = $("heroSearch").value;
  renderJobs();
  scrollTo("jobs");
});

$("heroSearch").addEventListener("keydown",event=>{
  if(event.key === "Enter"){
    event.preventDefault();
    $("heroSearchButton").click();
  }
});


/* =====================================================
   MODAL CLOSES
===================================================== */

document.querySelectorAll("[data-close]").forEach(button=>{
  button.addEventListener("click",()=>closeModal(button.dataset.close));
});

document.querySelectorAll(".modal-bg").forEach(backdrop=>{
  backdrop.addEventListener("click",event=>{
    if(event.target === backdrop){
      backdrop.classList.add("hidden");
    }
  });
});

document.addEventListener("keydown",event=>{
  if(event.key === "Escape"){
    document.querySelectorAll(".modal-bg").forEach(modal=>modal.classList.add("hidden"));
  }
});


/* =====================================================
   STARTUP
===================================================== */

(async function init(){
  try{
    const { data } = await supabase.auth.getSession();
    currentSession = data.session;
    await loadAll();
  }catch(error){
    console.error(error);
  }
})();

</script>

</body>
</html>
