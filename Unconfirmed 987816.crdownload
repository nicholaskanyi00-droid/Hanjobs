<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HANJOBS — Find Your Next Job</title>
<meta name="description" content="HANJOBS — a professional Kenyan job and gig platform.">

<style>
:root{
  --navy:#102a43;
  --navy-dark:#091c30;
  --blue:#1769c2;
  --blue-dark:#12549b;
  --blue-soft:#edf5fd;
  --green:#198754;
  --green-soft:#eaf7f1;
  --red:#c62828;
  --yellow:#f4c542;
  --ink:#172333;
  --muted:#68788c;
  --line:#dce4ec;
  --bg:#f6f8fb;
  --white:#fff;
  --shadow:0 10px 30px rgba(16,42,67,.08);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#fff;color:var(--ink);font-family:Inter,Arial,Helvetica,sans-serif;line-height:1.5}
a{text-decoration:none;color:inherit}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.hidden{display:none!important}
.container{width:min(1180px,92%);margin:auto}

header{position:sticky;top:0;z-index:100;background:#fff;border-bottom:1px solid var(--line)}
.nav{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{font-size:28px;font-weight:900;color:var(--navy);letter-spacing:-1px}
.logo span{color:var(--blue)}
.nav-links{display:flex;gap:27px;color:#46596f;font-size:14px;font-weight:700}
.nav-links a:hover{color:var(--blue)}
.nav-actions{display:flex;align-items:center;gap:9px}
.user-pill{font-size:13px;font-weight:800;color:var(--navy);padding:10px 12px;background:var(--blue-soft);border-radius:8px}

.btn{border:1px solid transparent;border-radius:8px;padding:11px 17px;font-size:14px;font-weight:800;transition:.17s ease}
.btn:hover{transform:translateY(-1px)}
.btn-primary{background:var(--blue);color:#fff}
.btn-primary:hover{background:var(--blue-dark)}
.btn-secondary{background:#fff;color:var(--navy);border-color:#cbd5df}
.btn-secondary:hover{background:var(--bg)}
.btn-dark{background:var(--navy);color:#fff}
.btn-success{background:var(--green);color:#fff}
.btn-danger{background:#fff;color:var(--red);border-color:#e4bcbc}
.btn-block{width:100%}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none}

.hero{background:linear-gradient(180deg,#f3f7fc 0,#fff 100%);border-bottom:1px solid var(--line);padding:76px 0 58px}
.hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:48px;align-items:center}
.hero-label{display:inline-block;padding:6px 11px;border-radius:999px;background:var(--blue-soft);color:var(--blue-dark);font-size:12px;font-weight:900;margin-bottom:16px}
.hero h1{margin:0;color:var(--navy);font-size:clamp(42px,5.8vw,72px);line-height:1.03;letter-spacing:-2.6px}
.hero-sub{max-width:730px;margin:21px 0 27px;color:#596a7e;font-size:19px}
.hero-search{padding:12px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}
.search-row{display:grid;grid-template-columns:1fr auto;gap:10px}
.search-input{width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:8px;outline:none}
.search-input:focus{border-color:#8fb9e7;box-shadow:0 0 0 3px rgba(23,105,194,.08)}
.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.hero-card{background:var(--navy);color:#fff;padding:30px;border-radius:16px;box-shadow:var(--shadow)}
.hero-card small{color:#a7b8cd;font-size:11px;font-weight:900;letter-spacing:1px}
.hero-card h2{margin:9px 0 13px;font-size:30px;line-height:1.1}
.hero-card p{margin:0 0 22px;color:#d3deea;font-size:15px}

section{padding:78px 0}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}
.section-head h2{margin:0;color:var(--navy);font-size:31px;letter-spacing:-.7px}
.section-head p{margin:5px 0 0;color:var(--muted);font-size:14px}
.results{color:var(--muted);font-size:14px;font-weight:700}

.featured{background:#eef5fc;border-bottom:1px solid var(--line)}
.feature-card{background:#fff;border:1px solid #d4e0ec;border-radius:14px;padding:28px;display:grid;grid-template-columns:1.25fr .75fr;gap:30px;align-items:center;box-shadow:var(--shadow)}
.feature-label{color:var(--blue);font-size:11px;font-weight:900;letter-spacing:1.2px}
.feature-title{margin:8px 0 12px;color:var(--navy);font-size:32px;line-height:1.08}
.feature-copy{color:#586a7f;font-size:15px;max-width:700px}
.feature-meta{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:22px}
.meta-box{padding:13px;background:var(--bg);border:1px solid var(--line);border-radius:9px}
.meta-box span{display:block;color:var(--muted);font-size:10px;font-weight:900;margin-bottom:3px}
.meta-box strong{color:var(--navy);font-size:14px}
.feature-side{border-left:1px solid var(--line);padding-left:30px}
.feature-pay{color:var(--green);font-size:26px;font-weight:900;margin-bottom:17px}

.jobs-section{background:#fff}
.filters{display:grid;grid-template-columns:1.4fr repeat(4,1fr);gap:10px;margin-bottom:24px}
.filter{width:100%;padding:11px 12px;background:#fff;border:1px solid var(--line);border-radius:8px;outline:none;color:#40536a}
.filter:focus{border-color:#8fb9e7}
.jobs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.job-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:22px;display:flex;flex-direction:column;min-height:310px;box-shadow:0 4px 14px rgba(16,42,67,.035);transition:.17s ease}
.job-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.job-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.company{color:var(--muted);font-size:13px;font-weight:700;margin-bottom:4px}
.job-title{margin:0;color:var(--navy);font-size:22px;line-height:1.18}
.badges{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.badge{padding:5px 8px;border-radius:999px;background:#eef5fc;border:1px solid #d8e7f7;color:var(--blue-dark);font-size:10px;font-weight:900;white-space:nowrap}
.badge-demo{background:#fff8df;border-color:#ead9a4;color:#6c5b18}
.job-description{margin:17px 0;color:#5a6b7f;font-size:14px}
.job-meta{display:flex;flex-wrap:wrap;gap:9px 17px;color:#5a6c80;font-size:13px;padding-bottom:17px;border-bottom:1px solid var(--line)}
.job-meta span{display:flex;align-items:center;gap:6px}
.dot{width:6px;height:6px;border-radius:50%;background:#95a5b7}
.job-bottom{margin-top:auto;padding-top:17px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.salary{color:var(--navy);font-size:14px;font-weight:900}
.job-buttons{display:flex;gap:8px}
.no-results{grid-column:1/-1;text-align:center;padding:60px;border:1px dashed #cbd5df;border-radius:12px;color:var(--muted)}

.completed{background:var(--bg);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.completed-grid{display:grid;grid-template-columns:1fr .65fr;gap:18px}
.completed-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:25px}
.completed-label{color:var(--green);font-size:11px;font-weight:900;letter-spacing:1px}
.completed-title{margin:9px 0;color:var(--navy);font-size:25px;line-height:1.15;font-weight:900}
.completed-meta{display:flex;flex-wrap:wrap;gap:8px 17px;color:var(--muted);font-size:13px}
.stars{color:#d69c00;letter-spacing:2px}
.completed-quote{margin-top:19px;padding-top:17px;border-top:1px solid var(--line);color:#526477;font-size:15px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:24px}
.stat strong{display:block;color:var(--navy);font-size:30px}
.stat span{color:var(--muted);font-size:11px;font-weight:900;text-transform:uppercase}

.community{background:#fff}
.profiles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.profile-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:22px;box-shadow:0 4px 14px rgba(16,42,67,.035)}
.profile-demo{font-size:10px;font-weight:900;letter-spacing:1px;color:#765f12;margin-bottom:13px}
.profile-top{display:flex;align-items:center;gap:13px}
.avatar{width:58px;height:58px;border-radius:50%;background:var(--blue-soft);color:var(--blue-dark);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;font-size:18px;font-weight:900}
.avatar img{width:100%;height:100%;object-fit:cover}
.profile-name{color:var(--navy);font-size:17px;font-weight:900}
.profile-location{color:var(--muted);font-size:13px}
.profile-rating{margin-top:16px;font-size:14px}
.profile-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:15px}
.profile-stat{padding:10px;background:var(--bg);border:1px solid var(--line);border-radius:8px}
.profile-stat strong{display:block;color:var(--navy);font-size:17px}
.profile-stat span{color:var(--muted);font-size:10px;font-weight:900;text-transform:uppercase}
.instagram-link{display:inline-block;margin-top:15px;color:var(--blue);font-size:13px;font-weight:800}

.dashboard{background:#eef5fc;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.dashboard-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.dashboard-panel{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.dashboard-head{padding:21px 23px;border-bottom:1px solid var(--line)}
.dashboard-head h3{margin:0;color:var(--navy);font-size:21px}
.dashboard-head p{margin:4px 0 0;color:var(--muted);font-size:13px}
.dashboard-body{padding:20px}
.demo-banner{margin-bottom:18px;padding:11px 13px;background:#fff8df;border:1px solid #ead9a4;color:#6c5b18;border-radius:8px;font-size:12px}
.my-job{padding:16px 0;border-bottom:1px solid var(--line)}
.my-job:last-child{border-bottom:0}
.my-job-head{display:flex;justify-content:space-between;gap:12px;align-items:start}
.my-job h4{margin:0;color:var(--navy);font-size:16px}
.my-job small{color:var(--muted)}
.my-job-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}
.applicant{padding:16px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:15px}
.applicant:last-child{border-bottom:0}
.applicant-main{display:flex;gap:12px;align-items:center}
.applicant-avatar{width:46px;height:46px;border-radius:50%;background:var(--blue-soft);color:var(--blue-dark);display:flex;align-items:center;justify-content:center;font-weight:900;overflow:hidden}
.applicant-avatar img{width:100%;height:100%;object-fit:cover}
.applicant-name{font-weight:900;color:var(--navy);font-size:14px}
.applicant-meta{color:var(--muted);font-size:12px}
.applicant-rating{color:#d69c00;font-size:12px}
.applicant-buttons{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.status{display:inline-block;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:900;text-transform:uppercase}
.status-applied{background:#edf5fd;color:#2b5f96}
.status-under_review{background:#fff8df;color:#705d17}
.status-accepted{background:var(--green-soft);color:#166844}
.status-declined{background:var(--red-soft);color:#9f2b23}
.status-completed{background:#e7f1ff;color:#245e9d}

.locations{background:#fff}
.location-grid{display:flex;flex-wrap:wrap;gap:9px}
.location-tag{padding:8px 13px;background:#fff;border:1px solid var(--line);border-radius:999px;color:#43566d;font-size:13px;font-weight:700}

.modal-bg{position:fixed;inset:0;z-index:500;background:rgba(7,24,42,.58);display:flex;justify-content:center;align-items:center;padding:20px}
.modal{width:min(620px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:14px;box-shadow:0 25px 70px rgba(0,0,0,.24)}
.modal-wide{width:min(820px,100%)}
.modal-head{padding:21px 23px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:start;gap:20px}
.modal-head h2{margin:0;color:var(--navy);font-size:24px}
.close{border:0;background:transparent;color:#6f8093;font-size:27px;line-height:1}
.modal-body{padding:23px}
.field{margin-bottom:16px}
.field label{display:block;margin-bottom:7px;color:#33485e;font-size:13px;font-weight:800}
.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:8px;outline:none;background:#fff;color:var(--ink)}
.field textarea{min-height:120px;resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus{border-color:#8fb9e7;box-shadow:0 0 0 3px rgba(23,105,194,.08)}
.form-row-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.notice{margin-top:13px;padding:12px 14px;background:var(--blue-soft);border:1px solid #d7e6f6;border-radius:8px;color:#49647f;font-size:13px}
.error{margin-top:13px;padding:12px 14px;background:var(--red-soft);border:1px solid #efc9c9;border-radius:8px;color:#9e2b23;font-size:13px}
.success{margin-top:13px;padding:12px 14px;background:var(--green-soft);border:1px solid #c7e7d7;border-radius:8px;color:#176744;font-size:13px}
.auth-switch{margin-top:16px;text-align:center;color:var(--muted);font-size:13px}
.auth-switch button{border:0;background:none;color:var(--blue);font-weight:800}
.auth-tabs{display:flex;gap:7px;margin-bottom:18px}
.auth-tab{flex:1;padding:10px;border:1px solid var(--line);border-radius:8px;background:#fff;font-weight:800;color:#55677b}
.auth-tab.active{background:var(--blue-soft);color:var(--blue-dark);border-color:#cfe0f2}
.summary{padding:16px;background:var(--bg);border:1px solid var(--line);border-radius:9px;margin-bottom:18px}
.summary-title{color:var(--navy);font-size:20px;font-weight:900}
.summary-meta{margin-top:5px;color:var(--muted);font-size:13px}
.requirements{margin:12px 0 0;padding-left:19px;color:#57697d;font-size:13px}
.detail-description{color:#4e6176;font-size:15px}
.profile-view-head{display:flex;align-items:center;gap:15px;margin-bottom:19px}
.profile-bio{color:#53667b;font-size:14px;margin-bottom:18px}
.rating-list{margin-top:20px;border-top:1px solid var(--line)}
.rating-item{padding:15px 0;border-bottom:1px solid var(--line)}
.rating-item:last-child{border-bottom:0}
.rating-author{font-weight:800;color:var(--navy);font-size:13px}
.rating-text{margin-top:5px;color:#56687d;font-size:13px}
.empty-dashboard{padding:30px 10px;text-align:center;color:var(--muted);font-size:13px}

footer{background:var(--navy-dark);color:#d7e0eb;padding:40px 0}
.footer{display:flex;justify-content:space-between;align-items:center;gap:20px}
.footer-logo{font-size:21px;font-weight:900;color:#fff}
.footer-logo span{color:#78b0e5}
.footer-text{color:#90a3b8;font-size:13px}

@media(max-width:1000px){
  .hero-grid{grid-template-columns:1fr}
  .feature-card{grid-template-columns:1fr}
  .feature-side{border-left:0;border-top:1px solid var(--line);padding-left:0;padding-top:25px}
  .filters{grid-template-columns:1fr 1fr}
  .completed-grid{grid-template-columns:1fr}
  .profiles{grid-template-columns:1fr 1fr}
  .dashboard-grid{grid-template-columns:1fr}
}

@media(max-width:720px){
  .nav{padding:10px 0;min-height:70px;flex-wrap:wrap}
  .nav-links{display:none}
  .nav-actions{margin-left:auto}
  .hero{padding:50px 0 42px}
  .search-row{grid-template-columns:1fr}
  .filters{grid-template-columns:1fr}
  .jobs{grid-template-columns:1fr}
  .profiles{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr}
  .form-row-two{grid-template-columns:1fr}
  .job-bottom{flex-direction:column;align-items:flex-start}
  .job-buttons{width:100%}
  .job-buttons .btn{flex:1}
  .applicant{flex-direction:column;align-items:flex-start}
  .applicant-buttons{justify-content:flex-start;width:100%}
  .footer{flex-direction:column;align-items:flex-start}
}
</style>
</head>

<body>

<header>
  <div class="container nav">
    <a href="#" class="logo">HAN<span>JOBS</span></a>

    <nav class="nav-links">
      <a href="#jobs">Find Jobs</a>
      <a href="#community">Bro Profiles</a>
      <a href="#dashboard">Dashboard</a>
      <a href="#locations">Locations</a>
    </nav>

    <div class="nav-actions">
      <div id="userPill" class="user-pill hidden"></div>
      <button id="authButton" class="btn btn-secondary">Sign In</button>
      <button id="postHeaderButton" class="btn btn-primary">Give a Bro a Job</button>
    </div>
  </div>
</header>


<section class="hero">
  <div class="container hero-grid">

    <div>
      <div class="hero-label">KENYA'S JOB & GIG PLATFORM</div>

      <h1>
        ECONOMY GOT YOU DOWN?<br>
        STRESSED ABOUT THE FUTURE?<br>
        SOUNDS LIKE YOU NEED A HANJOB.
      </h1>

      <p class="hero-sub">
        Find work, post an opening, build your Bro profile and get things done across Kenya.
      </p>

      <div class="hero-search">
        <div class="search-row">
          <input id="heroSearch" class="search-input" type="search" placeholder="Search jobs, roles or keywords">
          <button id="heroSearchButton" class="btn btn-primary">Search Jobs</button>
        </div>
      </div>

      <div class="hero-actions">
        <a href="#jobs" class="btn btn-primary">Apply for a Bro Job</a>
        <button id="heroPostButton" class="btn btn-secondary">Give a Bro a Job</button>
      </div>
    </div>

    <aside class="hero-card">
      <small>FOR BROs & EMPLOYERS</small>
      <h2>Need somebody to get it done?</h2>
      <p>Post an opening, receive applications, build a reputation and manage work from one place.</p>
      <button id="heroProfileButton" class="btn btn-primary">Create Your Profile</button>
    </aside>

  </div>
</section>


<section class="featured">
  <div class="container">

    <div class="section-head">
      <div>
        <h2>Bro of the Day</h2>
        <p>One featured opening selected for today.</p>
      </div>
    </div>

    <div id="featuredJob" class="feature-card"></div>

  </div>
</section>


<section id="jobs" class="jobs-section">
  <div class="container">

    <div class="section-head">
      <div>
        <h2>Available Jobs</h2>
        <p>Search current HANJOBS openings across Kenya.</p>
      </div>
      <div id="resultsCount" class="results"></div>
    </div>

    <div class="filters">
      <input id="jobSearch" class="filter" type="search" placeholder="Search jobs">

      <select id="locationFilter" class="filter">
        <option value="all">All locations</option>
      </select>

      <select id="typeFilter" class="filter">
        <option value="all">All job types</option>
        <option>Full-time</option>
        <option>Part-time</option>
        <option>Contract</option>
        <option>Casual</option>
      </select>

      <select id="payFilter" class="filter">
        <option value="all">All pay</option>
        <option value="with_pay">Pay specified</option>
        <option value="without_pay">Pay not specified</option>
      </select>

      <select id="sortFilter" class="filter">
        <option value="newest">Newest</option>
        <option value="az">Title A–Z</option>
        <option value="za">Title Z–A</option>
      </select>
    </div>

    <div id="jobsGrid" class="jobs"></div>

  </div>
</section>


<section class="completed">
  <div class="container">

    <div class="section-head">
      <div>
        <h2>Bro Job Completed</h2>
        <p>Community activity from completed work.</p>
      </div>
    </div>

    <div class="completed-grid">
      <div id="completedHighlight" class="completed-card"></div>

      <div class="stats">
        <div class="stat">
          <strong id="completedTotal">—</strong>
          <span>Bro Jobs Completed</span>
        </div>
        <div class="stat">
          <strong id="averageCommunityRating">—</strong>
          <span>Average Bro Rating</span>
        </div>
      </div>
    </div>

  </div>
</section>


<section id="community" class="community">
  <div class="container">

    <div class="section-head">
      <div>
        <h2>Bro Profiles</h2>
        <p>Professional profiles built from real HANJOBS activity.</p>
      </div>
      <button id="profileButton" class="btn btn-primary">Create / Edit Profile</button>
    </div>

    <div id="profilesGrid" class="profiles"></div>

  </div>
</section>


<section id="dashboard" class="dashboard">
  <div class="container">

    <div class="section-head">
      <div>
        <h2>HANJOBS Dashboard</h2>
        <p>Manage your jobs and applications.</p>
      </div>
    </div>

    <div class="dashboard-grid">

      <div class="dashboard-panel">
        <div class="dashboard-head">
          <h3>My Jobs</h3>
          <p>Jobs you have posted and their applicants.</p>
        </div>
        <div id="myJobs" class="dashboard-body"></div>
      </div>

      <div class="dashboard-panel">
        <div class="dashboard-head">
          <h3>My Applications</h3>
          <p>Track applications and completed Bro Jobs.</p>
        </div>
        <div id="myApplications" class="dashboard-body"></div>
      </div>

    </div>
  </div>
</section>


<section id="locations" class="locations">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>HANJOBS Across Kenya</h2>
        <p>Town and neighbourhood data used by the platform.</p>
      </div>
    </div>

    <div id="locationTags" class="location-grid"></div>
  </div>
</section>


<footer>
  <div class="container footer">
    <div class="footer-logo">HAN<span>JOBS</span></div>
    <div class="footer-text">Professional job platform. Questionable job opportunities.</div>
  </div>
</footer>


<!-- AUTH -->
<div id="authModal" class="modal-bg hidden">
  <div class="modal">
    <div class="modal-head">
      <h2 id="authTitle">Sign In</h2>
      <button class="close" data-close="authModal">&times;</button>
    </div>
    <div class="modal-body">

      <div class="auth-tabs">
        <button id="loginTab" class="auth-tab active">Sign In</button>
        <button id="signupTab" class="auth-tab">Create Account</button>
      </div>

      <form id="loginForm">
        <div class="field">
          <label>Email</label>
          <input id="loginEmail" type="email" required>
        </div>
        <div class="field">
          <label>Password</label>
          <input id="loginPassword" type="password" required>
        </div>
        <button id="loginSubmit" type="submit" class="btn btn-primary btn-block">Sign In</button>
        <div style="text-align:center;margin-top:13px;">
          <button id="forgotButton" type="button" class="btn btn-secondary">Forgot password?</button>
        </div>
      </form>

      <form id="signupForm" class="hidden">
        <div class="field">
          <label>Full Name</label>
          <input id="signupName" required>
        </div>
        <div class="field">
          <label>Email</label>
          <input id="signupEmail" type="email" required>
        </div>
        <div class="field">
          <label>Password</label>
          <input id="signupPassword" type="password" minlength="6" required>
        </div>
        <div class="field">
          <label>Account Type</label>
          <select id="signupType">
            <option value="both">I want to find jobs and post jobs</option>
            <option value="bro">I'm mainly looking for jobs</option>
            <option value="employer">I'm mainly hiring people</option>
          </select>
        </div>
        <button id="signupSubmit" type="submit" class="btn btn-primary btn-block">Create Account</button>
      </form>

      <div id="authMessage"></div>
    </div>
  </div>
</div>


<!-- PASSWORD RESET -->
<div id="resetModal" class="modal-bg hidden">
  <div class="modal">
